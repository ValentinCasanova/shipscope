# Local development settings. Copy this file to .env (ignored by git):
#   cp .env.example .env
# and set DJANGO_SECRET_KEY. Deployed environments get these values from their
# runtime configuration (ECS task definition and AWS Secrets Manager) instead.

# Required. Generate a value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=shipscope
POSTGRES_USER=shipscope
POSTGRES_PASSWORD=shipscope-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Deployed environments set these. Leave them unset locally to keep the defaults.
# DJANGO_BEHIND_CLOUDFRONT=true
# POSTGRES_SSLMODE=require
